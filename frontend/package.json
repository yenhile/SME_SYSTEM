    "test:auth-sync": "node --test scripts/check-auth-sync.mjs",
    "test:sla-display": "node --test scripts/check-sla-display.mjs",
    "test:prediction-ui": "node --test scripts/check-prediction-ui.mjs",
    "test:preferences": "node --test scripts/check-user-preferences.mjs",
    "test:period-report": "node --test scripts/check-period-report.mjs",
