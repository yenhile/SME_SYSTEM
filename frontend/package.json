{
  "name": "sme-loan-workflow-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:api": "node --test scripts/check-api-client.mjs",
    "test:navigation": "node --test scripts/check-navigation.mjs",
    "test:auth-sync": "node --test scripts/check-auth-sync.mjs",
    "test:sla-display": "node --test scripts/check-sla-display.mjs",
    "test:password": "node --test scripts/check-change-password.mjs",
    "test:close-overdue": "node --test scripts/check-close-overdue-ui.mjs",
    "test:tracking": "node --test scripts/check-portal-tracking-ui.mjs",
    "test:tax-check": "node --test scripts/check-tax-check-ui.mjs",
    "test:deadlines": "node --test scripts/check-supplement-deadline-ui.mjs",
    "test:intake": "node --test scripts/check-intake-ui.mjs scripts/check-intake-v2-ui.mjs",
    "test:supplements": "node --experimental-strip-types --test scripts/check-supplements-ui.mjs src/portal/supplements.test.mjs",
    "test:portal": "node --experimental-strip-types --test src/portal/model.test.mjs src/portal/client.test.mjs src/portal/wizard.test.mjs src/portal/intake-cycle.test.mjs",
    "check:portal-intake-cycle": "node scripts/check-portal-intake-cycle-browser.mjs",
    "check:portal-v2": "node scripts/check-portal-v2-browser.mjs",
    "check:portal-v2-intake": "node scripts/check-portal-v2-intake-browser.mjs",
    "check:portal-mvp": "node scripts/check-portal-mvp-supplements-browser.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.1.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "typescript": "^5.7.3"
  }
}
