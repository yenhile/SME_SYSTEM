# ==============================================================================
# HỆ THỐNG BIẾN MÔI TRƯỜNG DỰ ÁN SME LOAN WORKFLOW (FILE MẪU .ENV.EXAMPLE)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH DÀNH CHO LOCAL DEVELOPMENT (Mặc định khi clone về phát triển)
# ------------------------------------------------------------------------------
POSTGRES_DB=sme_loan
POSTGRES_USER=sme_user
POSTGRES_PASSWORD=sme_password

DATABASE_URL=postgresql://sme_user:sme_password@localhost:5432/sme_loan?schema=public
ML_SERVICE_URL=http://localhost:8000
VITE_API_URL=http://localhost:3000/api

# Portal email. MAIL_PROVIDER=brevo gửi thật qua Brevo API (bắt buộc khi NODE_ENV=production).
# MAIL_PROVIDER=local chỉ dùng cho development/test: thư vào hộp thư local http://localhost:8025
# (bật bằng npm.cmd --prefix backend run mail:dev). Bỏ trống thì tự chọn brevo khi có BREVO_API_KEY.
MAIL_PROVIDER=local
# Lấy tại Brevo > SMTP & API > API Keys (dạng xkeysib-...). Không commit giá trị thật.
BREVO_API_KEY=
# Địa chỉ gửi phải là sender đã xác minh (tốt nhất thuộc domain đã xác thực) trong Brevo.
MAIL_FROM_EMAIL=noreply@sme-loan.local
MAIL_FROM_NAME=SME Loan
# Hộp thư local (MAIL_PROVIDER=local).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
# Địa chỉ công khai của frontend để tạo liên kết đặt lại mật khẩu Portal.
FRONTEND_URL=http://localhost:5173
# Nơi lưu tệp doanh nghiệp/cán bộ tải lên: local (thư mục UPLOAD_ROOT, mặc định backend/uploads) hoặc supabase.
# supabase: bucket riêng tư, chỉ backend đọc/ghi bằng service role key. Không commit giá trị thật.
STORAGE_PROVIDER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=sme-documents
# Portal V2: bật để dùng giao diện lưu nháp trên development/test.
# Mặc định tắt; start-local.ps1 bật riêng trong tiến trình backend development.
# Preview cũ không tự mở gửi/tiếp nhận V2 trong production.
PORTAL_FOUNDATION_PREVIEW=false
# Cờ submit thử nghiệm cũ chỉ dùng cùng context/schema cách ly.
# Phát hành V2 dùng PORTAL_V2_ROLLOUT_ENABLED ở dưới sau nghiệm thu.
PORTAL_V2_SUBMIT_ENABLED=false
# Mở V2 sản xuất/thương mại/dịch vụ sau migration và nghiệm thu môi trường đích.
# Cờ này không kích hoạt SLA PA1.
PORTAL_V2_ROLLOUT_ENABLED=false

# ------------------------------------------------------------------------------
# 2. CẤU HÌNH DÀNH CHO DOCKER / PRODUCTION (Mở comment khi triển khai thực tế)
# ------------------------------------------------------------------------------
# DATABASE_URL=postgresql://sme_user:sme_password@db:5432/sme_loan?schema=public
# ML_SERVICE_URL=http://ml-service:8000
# VITE_API_URL=http://localhost:3001/api
# PORT=3000
# JWT_SECRET: BẮT BUỘC (Docker từ chối khởi động nếu thiếu). Dùng chuỗi ngẫu nhiên từ 32 ký tự, ví dụ:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# JWT_SECRET=<chuỗi-ngẫu-nhiên-của-bạn>
