# ==============================================================================
# HỆ THỐNG BIẾN MÔI TRƯỜNG DỰ ÁN SME LOAN WORKFLOW (FILE MẪU .ENV.EXAMPLE)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH DÀNH CHO LOCAL DEVELOPMENT (Mặc định khi clone về phát triển)
# ------------------------------------------------------------------------------
POSTGRES_DB=sme_loan
POSTGRES_USER=sme_user
POSTGRES_PASSWORD=sme_password

DATABASE_URL=postgresql://sme_user:sme_password@localhost:5432/sme_loan?schema=public
ML_SERVICE_URL=http://localhost:8000
VITE_API_URL=http://localhost:3000/api

# Portal: hộp thư local, không gửi email ra Internet.
# Backend dùng các mặc định này khi chưa cấu hình; bật SMTP local bằng npm.cmd --prefix backend run mail:dev.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=noreply@sme-loan.local
# Portal V2: bật để dùng giao diện lưu nháp trên development/test.
# Mặc định tắt; start-local.ps1 bật riêng trong tiến trình backend development.
# Không mở gửi/tiếp nhận V2 khi checklist còn chờ duyệt chính sách.
PORTAL_FOUNDATION_PREVIEW=false
# Submit/Accept V2 giữ OFF. Đổi flag đơn lẻ không mở được chức năng:
# chỉ harness test có context được inject + schema cách ly mới được sử dụng.
PORTAL_V2_SUBMIT_ENABLED=false
# SMTP_USER=
# SMTP_PASS=

# ------------------------------------------------------------------------------
# 2. CẤU HÌNH DÀNH CHO DOCKER / PRODUCTION (Mở comment khi triển khai thực tế)
# ------------------------------------------------------------------------------
# DATABASE_URL=postgresql://sme_user:sme_password@db:5432/sme_loan?schema=public
# ML_SERVICE_URL=http://ml-service:8000
# VITE_API_URL=http://localhost:3001/api
# PORT=3000
# JWT_SECRET=sme_loan_production_super_secret_key_change_me_2026
